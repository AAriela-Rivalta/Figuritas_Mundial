{
  "expo": {
    "name": "figus",
    "slug": "figuritas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/balon-de-futbol.png",
    "scheme": "figus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.emmabria.figuritas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/balon-de-futbol.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f923f40-bde1-4d83-8eab-5d24d5698bea"
      }
    },
    "owner": "arielarivaltas-team"
  }
}
